// =====================================================
// Web Handlers
// =====================================================
void handleRoot() {
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/html", getWebPage());
}

void handleCommand() {
  String moveCommand = "S";
  int speedValue = 180;

  if (server.hasArg("move")) {
    moveCommand = server.arg("move");
  }

  if (server.hasArg("speed")) {
    speedValue = server.arg("speed").toInt();
  }

  speedValue = constrain(speedValue, 0, 255);

  moveCar(moveCommand, speedValue);
  lastCommandTime = millis();

  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain", "OK");
}

void handleNotFound() {
  server.send(404, "text/plain", "Not Found");
}

// =====================================================
// WiFi Setup
// =====================================================
void setupWiFi() {
  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);
  WiFi.setTxPower(WIFI_POWER_19_5dBm);

  esp_wifi_set_mac(WIFI_IF_AP, DEVKIT_AP_MAC);

  WiFi.softAPConfig(AP_IP, AP_GATEWAY, AP_SUBNET);

  bool result = WiFi.softAP(ssid, password, WIFI_CHANNEL, 0, 4);

  if (!result) {
    Serial.println("WiFi AP start failed");
  }

  Serial.println();
  Serial.println("====================================");
  Serial.println("ESP32 DEVKIT CONTROLLER STARTED");
  Serial.println("====================================");
  Serial.print("WiFi Name: ");
  Serial.println(ssid);
  Serial.print("Password: ");
  Serial.println(password);
  Serial.print("DevKit IP: ");
  Serial.println(WiFi.softAPIP());
  Serial.print("DevKit Fixed AP MAC: ");
  Serial.println(WiFi.softAPmacAddress());
  Serial.print("Camera Stream URL: ");
  Serial.println(camStreamURL);
  Serial.println("Open on mobile: http://192.168.10.1");
  Serial.println("====================================");
}

// =====================================================
// Setup
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LEFT_IN1, OUTPUT);
  pinMode(LEFT_IN2, OUTPUT);
  pinMode(RIGHT_IN1, OUTPUT);
  pinMode(RIGHT_IN2, OUTPUT);

  setupPWM();
  stopCar();

  setupWiFi();

  server.on("/", handleRoot);
  server.on("/cmd", handleCommand);
  server.onNotFound(handleNotFound);
  server.begin();

  lastCommandTime = millis();

  Serial.println("Web server started");
}

// =====================================================
// Loop
// =====================================================
void loop() {
  server.handleClient();

  if (millis() - lastCommandTime > COMMAND_TIMEOUT) {
    stopCar();
  }
}
