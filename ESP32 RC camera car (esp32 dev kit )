    const speedSlider = document.getElementById("speed");
    const speedValue = document.getElementById("speedValue");

    const lightSlider = document.getElementById("light");
    const lightValue = document.getElementById("lightValue");

    const statusBox = document.getElementById("status");
    const cam = document.getElementById("cam");

    let commandTimer = null;
    let lightTimer = null;

    speedSlider.addEventListener("input", () => {
      speedValue.innerText = speedSlider.value;
    });

    lightSlider.addEventListener("input", () => {
      lightValue.innerText = lightSlider.value;

      if (lightTimer) {
        clearTimeout(lightTimer);
      }

      lightTimer = setTimeout(() => {
        sendLight(lightSlider.value);
      }, 60);
    });

    function sendCommand(move) {
      const speed = speedSlider.value;

      fetch(`/cmd?move=${move}&speed=${speed}`, { cache: "no-store" })
        .then(() => {
          statusBox.innerText = "Command: " + move + " | Speed: " + speed;
          statusBox.style.color = "#22c55e";
        })
        .catch(() => {
          statusBox.innerText = "Controller command error";
          statusBox.style.color = "#ef4444";
        });
    }

    function sendLight(value) {
      fetch(`http://192.168.10.200/flash?value=${value}`, { cache: "no-store" })
        .then(() => {
          statusBox.innerText = "Camera Light: " + value;
          statusBox.style.color = "#38bdf8";
        })
        .catch(() => {
          statusBox.innerText = "Camera light control error";
          statusBox.style.color = "#ef4444";
        });
    }

    function startMove(move) {
      sendCommand(move);

      if (commandTimer) {
        clearInterval(commandTimer);
      }

      commandTimer = setInterval(() => {
        sendCommand(move);
      }, 220);
    }

    function stopMove() {
      if (commandTimer) {
        clearInterval(commandTimer);
        commandTimer = null;
      }

      sendCommand("S");
    }

    document.querySelectorAll("button[data-move]").forEach(btn => {
      const move = btn.getAttribute("data-move");

      btn.addEventListener("pointerdown", e => {
        e.preventDefault();

        if (move === "S") {
          stopMove();
        } else {
          startMove(move);
        }
      });

      btn.addEventListener("pointerup", e => {
        e.preventDefault();
        stopMove();
      });

      btn.addEventListener("pointerleave", e => {
        e.preventDefault();
        stopMove();
      });

      btn.addEventListener("touchcancel", e => {
        e.preventDefault();
        stopMove();
      });
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopMove();
      }
    });

    window.addEventListener("beforeunload", () => {
      navigator.sendBeacon("/cmd?move=S&speed=0");
    });

    function cameraError() {
      statusBox.innerText = "Camera not found. Check ESP32-CAM power.";
      statusBox.style.color = "#ef4444";

      setTimeout(() => {
        cam.src = "http://192.168.10.200/stream?t=" + Date.now();
      }, 1500);
    }
  </script>
