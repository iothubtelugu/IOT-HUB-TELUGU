#include <WiFi.h>
#include <WebServer.h>
#include <esp_wifi.h>

// =====================================================
// ESP32 DevKit WiFi Hotspot Details
// =====================================================
const char* ssid = "ESP32-RC-CAR";
const char* password = "12345678";

#define WIFI_CHANNEL 6

// Fixed AP MAC address for ESP32 DevKit
// ESP32-CAM connects to this exact MAC address
uint8_t DEVKIT_AP_MAC[] = {0x02, 0xA1, 0xB2, 0xC3, 0xD4, 0xE5};

// Custom IP network
IPAddress AP_IP(192, 168, 10, 1);
IPAddress AP_GATEWAY(192, 168, 10, 1);
IPAddress AP_SUBNET(255, 255, 255, 0);

// ESP32-CAM fixed stream and flash URLs
const char* camStreamURL = "http://192.168.10.200/stream";
const char* camFlashURL = "http://192.168.10.200/flash";

// =====================================================
// L298N Motor Driver Pins
// =====================================================
#define LEFT_EN     25
#define LEFT_IN1    26
#define LEFT_IN2    27

#define RIGHT_EN    33
#define RIGHT_IN1   18
#define RIGHT_IN2   19

// =====================================================
// PWM Settings for ESP32 Arduino Core 3.x
// =====================================================
const int PWM_FREQ = 1000;
const int PWM_RESOLUTION = 8;

// =====================================================
// Web Server
// =====================================================
WebServer server(80);

// Safety stop
unsigned long lastCommandTime = 0;
const unsigned long COMMAND_TIMEOUT = 700;

// =====================================================
// PWM Functions
// =====================================================
void setupPWM() {
  ledcAttach(LEFT_EN, PWM_FREQ, PWM_RESOLUTION);
  ledcAttach(RIGHT_EN, PWM_FREQ, PWM_RESOLUTION);
}

void writePWMValue(int pin, int value) {
  value = constrain(value, 0, 255);
  ledcWrite(pin, value);
}

// =====================================================
// Motor Functions
// =====================================================
void setLeftMotor(int speedValue) {
  speedValue = constrain(speedValue, -255, 255);

  if (speedValue > 0) {
    digitalWrite(LEFT_IN1, HIGH);
    digitalWrite(LEFT_IN2, LOW);
    writePWMValue(LEFT_EN, speedValue);
  } 
  else if (speedValue < 0) {
    digitalWrite(LEFT_IN1, LOW);
    digitalWrite(LEFT_IN2, HIGH);
    writePWMValue(LEFT_EN, -speedValue);
  } 
  else {
    digitalWrite(LEFT_IN1, LOW);
    digitalWrite(LEFT_IN2, LOW);
    writePWMValue(LEFT_EN, 0);
  }
}

void setRightMotor(int speedValue) {
  speedValue = constrain(speedValue, -255, 255);

  if (speedValue > 0) {
    digitalWrite(RIGHT_IN1, HIGH);
    digitalWrite(RIGHT_IN2, LOW);
    writePWMValue(RIGHT_EN, speedValue);
  } 
  else if (speedValue < 0) {
    digitalWrite(RIGHT_IN1, LOW);
    digitalWrite(RIGHT_IN2, HIGH);
    writePWMValue(RIGHT_EN, -speedValue);
  } 
  else {
    digitalWrite(RIGHT_IN1, LOW);
    digitalWrite(RIGHT_IN2, LOW);
    writePWMValue(RIGHT_EN, 0);
  }
}

void stopCar() {
  setLeftMotor(0);
  setRightMotor(0);
}

void moveCar(String moveCommand, int speedValue) {
  speedValue = constrain(speedValue, 0, 255);

  int turnSpeed = (speedValue * 85) / 100;
  int slowSpeed = (speedValue * 45) / 100;

  if (moveCommand == "F") {
    setLeftMotor(speedValue);
    setRightMotor(speedValue);
  } 
  else if (moveCommand == "B") {
    setLeftMotor(-speedValue);
    setRightMotor(-speedValue);
  } 
  else if (moveCommand == "L") {
    setLeftMotor(-turnSpeed);
    setRightMotor(turnSpeed);
  } 
  else if (moveCommand == "R") {
    setLeftMotor(turnSpeed);
    setRightMotor(-turnSpeed);
  } 
  else if (moveCommand == "FL") {
    setLeftMotor(slowSpeed);
    setRightMotor(speedValue);
  } 
  else if (moveCommand == "FR") {
    setLeftMotor(speedValue);
    setRightMotor(slowSpeed);
  } 
  else if (moveCommand == "BL") {
    setLeftMotor(-slowSpeed);
    setRightMotor(-speedValue);
  } 
  else if (moveCommand == "BR") {
    setLeftMotor(-speedValue);
    setRightMotor(-slowSpeed);
  } 
  else {
    stopCar();
  }
}

