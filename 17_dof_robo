// ============================================================================
// WEB SERVER API HANDLERS
// ============================================================================
void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleWalk() {
  if (!server.hasArg("cmd")) {
    server.send(400, "application/json", "{\"error\":\"Missing cmd\"}");
    return;
  }
  String cmd = server.arg("cmd");
  Serial.printf("[WEB] Walk Command: %s\n", cmd.c_str());

  if (cmd.equalsIgnoreCase("forward")) {
    activeWalkMode = WALK_FWD;
    stopGaitRequested = false;
    gaitPhase = 0;
  } else if (cmd.equalsIgnoreCase("backward")) {
    activeWalkMode = WALK_BWD;
    stopGaitRequested = false;
    gaitPhase = 0;
  } else if (cmd.equalsIgnoreCase("left")) {
    activeWalkMode = WALK_LEFT;
    stopGaitRequested = false;
    gaitPhase = 0;
  } else if (cmd.equalsIgnoreCase("right")) {
    activeWalkMode = WALK_RIGHT;
    stopGaitRequested = false;
    gaitPhase = 0;
  } else if (cmd.equalsIgnoreCase("stop")) {
    stopGaitRequested = true;
  }

  server.send(200, "application/json", "{\"status\":\"ok\"}");
}

void handleGaitParams() {
  if (server.hasArg("lean"))  LEAN_ANGLE  = server.arg("lean").toInt();
  if (server.hasArg("step"))  STEP_LENGTH = server.arg("step").toInt();
  if (server.hasArg("lift"))  LIFT_HEIGHT = server.arg("lift").toInt();
  if (server.hasArg("speed")) STEP_SPEED  = server.arg("speed").toInt();

  Serial.printf("[GAIT] Updated: Lean=%d, Step=%d, Lift=%d, Speed=%d\n", 
                LEAN_ANGLE, STEP_LENGTH, LIFT_HEIGHT, STEP_SPEED);
  server.send(200, "application/json", "{\"status\":\"ok\"}");
}

void handlePose() {
  if (!server.hasArg("name")) {
    server.send(400, "application/json", "{\"error\":\"Missing pose name\"}");
    return;
  }
  String name = server.arg("name");
  Serial.printf("[WEB] Command Pose: %s\n", name.c_str());

  activeWalkMode = WALK_STOP;

  if (name.equalsIgnoreCase("stand")) {
    startMoveTo(POSE_STAND, 700);
  } else if (name.equalsIgnoreCase("squat")) {
    startMoveTo(POSE_SQUAT, 800);
  } else if (name.equalsIgnoreCase("bow")) {
    triggerBowSequence();
  } else if (name.equalsIgnoreCase("wave")) {
    triggerWaveSequence();
  }

  server.send(200, "application/json", "{\"status\":\"ok\"}");
}

void handleJoint() {
  if (!server.hasArg("code") || !server.hasArg("angle")) {
    server.send(400, "application/json", "{\"error\":\"Missing code or angle\"}");
    return;
  }
  String code = server.arg("code");
  int angle = server.arg("angle").toInt();

  activeWalkMode = WALK_STOP;

  for (int i = 0; i < 17; i++) {
    if (code.equalsIgnoreCase(jointCodes[i])) {
      torqueEnabled = true;
      currentAngles[i] = angle;
      writeJointHardware(i, angle);
      server.send(200, "application/json", "{\"status\":\"ok\"}");
      return;
    }
  }
  server.send(404, "application/json", "{\"error\":\"Joint not found\"}");
}

void handleTrim() {
  if (!server.hasArg("code") || !server.hasArg("val")) {
    server.send(400, "application/json", "{\"error\":\"Missing code or val\"}");
    return;
  }
  String code = server.arg("code");
  int val = server.arg("val").toInt();

  for (int i = 0; i < 17; i++) {
    if (code.equalsIgnoreCase(jointCodes[i])) {
      trims[i] = val;
      writeJointHardware(i, currentAngles[i]);
      Serial.printf("[TRIM] %s trim updated to %+d\n", jointCodes[i], val);
      server.send(200, "application/json", "{\"status\":\"ok\"}");
      return;
    }
  }
  server.send(404, "application/json", "{\"error\":\"Joint not found\"}");
}

void handleRelease() {
  releaseServos();
  server.send(200, "application/json", "{\"status\":\"released\"}");
}

void handleStatus() {
  String json = "{\"angles\":{";
  for (int i = 0; i < 17; i++) {
    json += "\"" + String(jointCodes[i]) + "\":" + String((int)round(currentAngles[i]));
    if (i < 16) json += ",";
  }
  json += "},\"trims\":{";
  for (int i = 0; i < 17; i++) {
    json += "\"" + String(jointCodes[i]) + "\":" + String(trims[i]);
    if (i < 16) json += ",";
  }
  json += "}}";
  server.send(200, "application/json", json);
}

// ============================================================================
// SETUP & LOOP
// ============================================================================
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n[BOOT] Initializing 17-DOF Humanoid Master Controller...");

  // 1. Hardware Init
  Wire.begin(I2C_SDA, I2C_SCL);
  pca.begin();
  pca.setOscillatorFrequency(27000000);
  pca.setPWMFreq(50);

  ESP32PWM::allocateTimer(0);
  headServo.setPeriodHertz(50);
  headServo.attach(HEAD_PIN, 500, 2500);

  // Initialize tracked angles to Stand Pose
  for (int i = 0; i < 17; i++) {
    currentAngles[i] = POSE_STAND[i];
  }
  for (int i = 0; i < 17; i++) {
    writeJointHardware(i, currentAngles[i]);
    delay(70);
  }

  // 2. Wi-Fi SoftAP Setup
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  IPAddress IP = WiFi.softAPIP();

  Serial.println("\n=======================================================");
  Serial.println("  17-DOF Humanoid Master Controller is LIVE!");
  Serial.println("=======================================================");
  Serial.printf("  SSID     : %s\n", AP_SSID);
  Serial.printf("  Password : %s\n", AP_PASS);
  Serial.printf("  Web URL  : http://%s\n", IP.toString().c_str());
  if (MDNS.begin("humanoid")) {
    Serial.println("  mDNS URL : http://humanoid.local");
  }
  Serial.println("=======================================================\n");

  // 3. Web Server Routes
  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/walk", HTTP_GET, handleWalk);
  server.on("/api/gaitparams", HTTP_GET, handleGaitParams);
  server.on("/api/pose", HTTP_GET, handlePose);
  server.on("/api/joint", HTTP_GET, handleJoint);
  server.on("/api/trim", HTTP_GET, handleTrim);
  server.on("/api/release", HTTP_GET, handleRelease);
  server.on("/api/status", HTTP_GET, handleStatus);
  server.begin();
}

void loop() {
  server.handleClient();
  updateMotionEngine();
}
