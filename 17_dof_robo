// ============================================================================
// WALKING GAIT PARAMETERS & STATE MACHINE
// ============================================================================
int LEAN_ANGLE  = 12;   // Ankle roll tilt (degrees)
int STEP_LENGTH = 16;   // Hip forward swing (degrees)
int LIFT_HEIGHT = 20;   // Knee lift clearance (degrees)
int STEP_SPEED  = 280;  // ms per phase
int TURN_ANGLE  = 14;   // Hip turn angle (degrees)

enum WalkMode {
  WALK_STOP = 0,
  WALK_FWD,
  WALK_BWD,
  WALK_LEFT,
  WALK_RIGHT
};

WalkMode activeWalkMode = WALK_STOP;
int gaitPhase = 0;
bool stopGaitRequested = false;

// ============================================================================
// MOTION INTERPOLATION ENGINE (S-Curve Cosine Ease)
// ============================================================================
bool isMoving = false;
unsigned long moveStartTime = 0;
int moveDuration = 300;
float startAngles[17];
float targetAngles[17];

struct MotionStep {
  int pose[17];
  int duration;
  int pauseAfter;
};

#define MAX_QUEUE_STEPS 8
MotionStep sequenceQueue[MAX_QUEUE_STEPS];
int sequenceLength = 0;
int currentStepIndex = -1;
unsigned long pauseUntil = 0;

int degreesToTicks(int angle) {
  angle = constrain(angle, 0, 180);
  return map(angle, 0, 180, SERVOMIN_TICKS, SERVOMAX_TICKS);
}

void writeJointHardware(int index, float rawAngle) {
  if (!torqueEnabled) return;
  int finalAngle = constrain((int)round(rawAngle + trims[index]), 0, 180);

  if (jointChannels[index] >= 0) {
    pca.setPWM(jointChannels[index], 0, degreesToTicks(finalAngle));
  } else {
    if (!headServo.attached()) headServo.attach(HEAD_PIN, 500, 2500);
    headServo.write(finalAngle);
  }
}

void startMoveTo(const int targetPose[17], int durationMs) {
  torqueEnabled = true;
  for (int i = 0; i < 17; i++) {
    startAngles[i] = currentAngles[i];
    targetAngles[i] = targetPose[i];
  }
  moveDuration = max(40, durationMs);
  moveStartTime = millis();
  isMoving = true;
}

void resetSequence() {
  sequenceLength = 0;
  currentStepIndex = -1;
  pauseUntil = 0;
}

void queueStep(const int targetPose[17], int duration, int pauseAfter = 0) {
  if (sequenceLength < MAX_QUEUE_STEPS) {
    memcpy(sequenceQueue[sequenceLength].pose, targetPose, sizeof(int) * 17);
    sequenceQueue[sequenceLength].duration = duration;
    sequenceQueue[sequenceLength].pauseAfter = pauseAfter;
    sequenceLength++;
  }
}

void startQueuedSequence() {
  if (sequenceLength > 0) {
    currentStepIndex = 0;
    pauseUntil = 0;
    startMoveTo(sequenceQueue[0].pose, sequenceQueue[0].duration);
  }
}

// ----------------------------------------------------------------------------
// Gait Calculation Functions
// ----------------------------------------------------------------------------
void buildWalkPose(int poseOut[17], int phase, int direction) {
  memcpy(poseOut, POSE_STAND, sizeof(int) * 17);
  int step = STEP_LENGTH * direction;
  int lean = LEAN_ANGLE;
  int lift = LIFT_HEIGHT;

  switch (phase) {
    case 0: // Shift weight Left
      poseOut[J_RAT] = 90 - lean;
      poseOut[J_LAT] = 90 - lean;
      poseOut[J_RHK] = 30 - 5;
      poseOut[J_LHK] = 150 - 5;
      break;

    case 1: // Swing Right Leg Forward
      poseOut[J_RAT] = 90 - lean;
      poseOut[J_LAT] = 90 - lean;
      poseOut[J_RH]  = 30 + step;
      poseOut[J_RK]  = 30 + lift;
      poseOut[J_RA]  = 150 - step - (lift / 2);
      poseOut[J_RHK] = 30 - 15;
      poseOut[J_LHK] = 150 - 15;
      break;

    case 2: // Right Foot Touchdown (Double Support)
      poseOut[J_RAT] = 90;
      poseOut[J_LAT] = 90;
      poseOut[J_RH]  = 30 + (step / 2);
      poseOut[J_RK]  = 30;
      poseOut[J_RA]  = 150 - (step / 2);
      poseOut[J_LH]  = 150 + (step / 2);
      poseOut[J_LA]  = 30 - (step / 2);
      break;

    case 3: // Shift weight Right
      poseOut[J_RAT] = 90 + lean;
      poseOut[J_LAT] = 90 + lean;
      poseOut[J_RHK] = 30 + 5;
      poseOut[J_LHK] = 150 + 5;
      break;

    case 4: // Swing Left Leg Forward
      poseOut[J_RAT] = 90 + lean;
      poseOut[J_LAT] = 90 + lean;
      poseOut[J_LH]  = 150 - step;
      poseOut[J_LK]  = 150 - lift;
      poseOut[J_LA]  = 30 + step + (lift / 2);
      poseOut[J_RHK] = 30 + 15;
      poseOut[J_LHK] = 150 + 15;
      break;

    case 5: // Left Foot Touchdown (Double Support)
      poseOut[J_RAT] = 90;
      poseOut[J_LAT] = 90;
      poseOut[J_LH]  = 150 - (step / 2);
      poseOut[J_LK]  = 150;
      poseOut[J_LA]  = 30 + (step / 2);
      poseOut[J_RH]  = 30 - (step / 2);
      poseOut[J_RA]  = 150 + (step / 2);
      break;
  }
}

void buildTurnPose(int poseOut[17], int phase, int turnDir) {
  memcpy(poseOut, POSE_STAND, sizeof(int) * 17);
  int lean = LEAN_ANGLE;
  int turn = TURN_ANGLE * turnDir;

  switch (phase) {
    case 0: // Shift weight Left
      poseOut[J_RAT] = 90 - lean;
      poseOut[J_LAT] = 90 - lean;
      break;
    case 1: // Rotate Right airborne leg
      poseOut[J_RAT] = 90 - lean;
      poseOut[J_LAT] = 90 - lean;
      poseOut[J_RHT] = 90 + turn;
      poseOut[J_RK]  = 30 + LIFT_HEIGHT;
      break;
    case 2: // Right Foot touchdown
      poseOut[J_RAT] = 90;
      poseOut[J_LAT] = 90;
      poseOut[J_RHT] = 90 + turn;
      break;
    case 3: // Shift weight Right
      poseOut[J_RAT] = 90 + lean;
      poseOut[J_LAT] = 90 + lean;
      break;
    case 4: // Rotate Left leg to re-align
      poseOut[J_RAT] = 90 + lean;
      poseOut[J_LAT] = 90 + lean;
      poseOut[J_LHT] = 90 + turn;
      poseOut[J_LK]  = 150 - LIFT_HEIGHT;
      break;
    case 5: // Touchdown aligned
      poseOut[J_RAT] = 90;
      poseOut[J_LAT] = 90;
      poseOut[J_RHT] = 90;
      poseOut[J_LHT] = 90;
      break;
  }
}

void stepWalkingGait() {
  if (activeWalkMode == WALK_STOP) return;

  if (stopGaitRequested) {
    if (gaitPhase == 2 || gaitPhase == 5) {
      activeWalkMode = WALK_STOP;
      stopGaitRequested = false;
      gaitPhase = 0;
      startMoveTo(POSE_STAND, 400);
      return;
    }
  }

  int targetPose[17];
  if (activeWalkMode == WALK_FWD) {
    buildWalkPose(targetPose, gaitPhase, +1);
    startMoveTo(targetPose, STEP_SPEED);
  } else if (activeWalkMode == WALK_BWD) {
    buildWalkPose(targetPose, gaitPhase, -1);
    startMoveTo(targetPose, STEP_SPEED);
  } else if (activeWalkMode == WALK_LEFT) {
    buildTurnPose(targetPose, gaitPhase, +1);
    startMoveTo(targetPose, STEP_SPEED);
  } else if (activeWalkMode == WALK_RIGHT) {
    buildTurnPose(targetPose, gaitPhase, -1);
    startMoveTo(targetPose, STEP_SPEED);
  }

  gaitPhase = (gaitPhase + 1) % 6;
}

void updateMotionEngine() {
  unsigned long now = millis();

  if (pauseUntil > 0) {
    if (now >= pauseUntil) {
      pauseUntil = 0;
      currentStepIndex++;
      if (currentStepIndex < sequenceLength) {
        startMoveTo(sequenceQueue[currentStepIndex].pose, sequenceQueue[currentStepIndex].duration);
      } else {
        resetSequence();
      }
    }
    return;
  }

  if (!isMoving) {
    if (activeWalkMode != WALK_STOP) {
      stepWalkingGait();
    }
    return;
  }

  unsigned long elapsed = now - moveStartTime;
  if (elapsed >= (unsigned long)moveDuration) {
    for (int i = 0; i < 17; i++) {
      currentAngles[i] = targetAngles[i];
      writeJointHardware(i, currentAngles[i]);
    }
    isMoving = false;

    if (currentStepIndex >= 0 && currentStepIndex < sequenceLength) {
      if (sequenceQueue[currentStepIndex].pauseAfter > 0) {
        pauseUntil = now + sequenceQueue[currentStepIndex].pauseAfter;
      } else {
        currentStepIndex++;
        if (currentStepIndex < sequenceLength) {
          startMoveTo(sequenceQueue[currentStepIndex].pose, sequenceQueue[currentStepIndex].duration);
        } else {
          resetSequence();
        }
      }
    }
  } else {
    float t = (float)elapsed / (float)moveDuration;
    float factor = 0.5f * (1.0f - cos(t * 3.14159265f));

    for (int i = 0; i < 17; i++) {
      float interpolated = startAngles[i] + (targetAngles[i] - startAngles[i]) * factor;
      currentAngles[i] = interpolated;
      writeJointHardware(i, interpolated);
    }
  }
}

void triggerWaveSequence() {
  int pWave1[17], pWave2[17];
  memcpy(pWave1, POSE_STAND, sizeof(pWave1));
  memcpy(pWave2, POSE_STAND, sizeof(pWave2));

  pWave1[J_RHK] = 120; pWave1[J_RP] = 90; pWave1[J_RE] = 15;
  pWave2[J_RHK] = 120; pWave2[J_RP] = 90; pWave2[J_RE] = 65;

  resetSequence();
  queueStep(pWave1, 600, 50);
  queueStep(pWave2, 250, 30);
  queueStep(pWave1, 250, 30);
  queueStep(pWave2, 250, 30);
  queueStep(POSE_STAND, 600, 0);
  startQueuedSequence();
}

void triggerBowSequence() {
  resetSequence();
  queueStep(POSE_BOW, 700, 600);
  queueStep(POSE_STAND, 700, 0);
  startQueuedSequence();
}

void releaseServos() {
  activeWalkMode = WALK_STOP;
  isMoving = false;
  resetSequence();
  torqueEnabled = false;
  for (int ch = 0; ch < 16; ch++) {
    pca.setPWM(ch, 0, 0);
  }
  headServo.detach();
  Serial.println("[TORQUE] Servos released.");
}

